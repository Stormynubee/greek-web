# Local development defaults. Never commit a real .env file.
APP_ENV=development
MONGO_URL=mongodb://localhost:27017/greekgodberry?replicaSet=rs0
DB_NAME=greekgodberry

DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback
FRONTEND_URL=http://localhost:3000

LOCKLY_API_BASE=https://replace-with-lockly-api
LOCKLY_API_KEY=replace-with-lockly-api-key

JWT_SECRET=replace-with-a-long-random-user-session-secret
ADMIN_JWT_SECRET=replace-with-a-different-long-random-admin-secret
OWNER_EMAIL=owner@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-local-password

# Comma-separated browser origins. Do not use * with credentialed cookies.
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=false
